manifest {
  name = 'methods/segger'
  mainScript = 'main.nf'
  nextflowVersion = '!>=20.12.1-edge'
  version = 'build_segger'
  description = 'Segger frames spatial transcriptomics cell segmentation as link prediction on a heterogeneous graph\nwhose nodes are individual transcripts and morphology-derived cell or nucleus boundaries, and whose\nedges connect transcripts to each other within a small radius (capturing local co-occurrence) and\ntranscripts to boundaries when a transcript falls inside a scaled polygon. A graph neural network\nis trained with a contrastive objective so that each transcript embedding is pulled toward the\nembedding of its true boundary and pushed away from neighboring ones. At inference time, every\ntranscript is reassigned to the boundary it most resembles in embedding space, subject to a\nsimilarity threshold that is either set globally or learned per gene. Because the model operates\non the transcript graph rather than on raster images, it refines the initial nucleus segmentation\nwith information about which transcripts genuinely belong to which cell, and can rescue transcripts\nthat the initial boundary segmentation missed. In this Viash component, an initial boundary\nset is taken from the vendor `cell_id` prior on the transcripts whenever it is present and\nfalls back to a Cellpose pass on `morphology_mip` when it is not; the boundaries plus the\ntranscripts are written to a Xenium-layout directory and handed to `segger segment`. The\nper-transcript reassignments are then projected back onto the initial nucleus masks by\nmajority vote and rasterized as the predicted label image.\n'
}

process.container = 'nextflow/bash:latest'

// detect tempdir
tempDir = java.nio.file.Paths.get(
  System.getenv('NXF_TEMP') ?:
    System.getenv('VIASH_TEMP') ?: 
    System.getenv('TEMPDIR') ?: 
    System.getenv('TMPDIR') ?: 
    '/tmp'
).toAbsolutePath()

profiles {
  no_publish {
    process {
      withName: '.*' {
        publishDir = [
          enabled: false
        ]
      }
    }
  }
  mount_temp {
    docker.temp            = tempDir
    podman.temp            = tempDir
    charliecloud.temp      = tempDir
  }
  docker {
    docker.enabled         = true
    // docker.userEmulation   = true
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    docker.enabled         = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  podman {
    podman.enabled         = true
    docker.enabled         = false
    singularity.enabled    = false
    shifter.enabled        = false
    charliecloud.enabled   = false
  }
  shifter {
    shifter.enabled        = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    charliecloud.enabled   = false
  }
  charliecloud {
    charliecloud.enabled   = true
    docker.enabled         = false
    singularity.enabled    = false
    podman.enabled         = false
    shifter.enabled        = false
  }
}

process{
  withLabel: lowmem { memory = 20.Gb }
  withLabel: midmem { memory = 50.Gb }
  withLabel: highmem { memory = 100.Gb }
  withLabel: lowcpu { cpus = 5 }
  withLabel: midcpu { cpus = 15 }
  withLabel: highcpu { cpus = 30 }
  withLabel: lowtime { time = 1.h }
  withLabel: midtime { time = 4.h }
  withLabel: hightime { time = 8.h }
  withLabel: veryhightime { time = 24.h }
}


